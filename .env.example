# ════════════════════════════════════════════════════════════════
# Application Configuration
# ════════════════════════════════════════════════════════════════
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# ════════════════════════════════════════════════════════════════
# PostgreSQL Configuration
# ════════════════════════════════════════════════════════════════
# Connection settings
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=payments_user
DB_PASSWORD=payments_pass
DB_DATABASE=payments_db

# TypeORM settings
DB_SYNCHRONIZE=false
DB_LOGGING=true

# ════════════════════════════════════════════════════════════════
# Kafka Configuration
# ════════════════════════════════════════════════════════════════
# KRaft mode (sin Zookeeper)
# Nota: En arquitecturas legacy con Zookeeper, también necesitarías
# KAFKA_ZOOKEEPER_CONNECT=localhost:2181
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=payments-service
KAFKA_GROUP_ID=payments-consumer-group

# Topics
KAFKA_TOPIC_PAYMENT_PAID=payment.paid

# mTLS (deshabilitado en local, habilitado en producción)
KAFKA_SSL_ENABLED=false
KAFKA_SSL_CA_PATH=./certs/ca.crt
KAFKA_SSL_CERT_PATH=./certs/relay.crt
KAFKA_SSL_KEY_PATH=./certs/relay.key

# ════════════════════════════════════════════════════════════════
# Relay Configuration (Outbox Processor)
# ════════════════════════════════════════════════════════════════
RELAY_POLLING_INTERVAL_MS=500
RELAY_BATCH_SIZE=50
RELAY_MAX_RETRIES=3

# ════════════════════════════════════════════════════════════════
# Observability (Prometheus Metrics)
# ════════════════════════════════════════════════════════════════
METRICS_ENABLED=true
METRICS_PORT=9464
